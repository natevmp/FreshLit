# Required for Codex LLM runs: path to a dedicated, existing mode-0700 Codex
# profile directory outside this repository. Authenticate it once with ChatGPT
# OAuth using the official Codex tooling before running FreshLit.
# `freshlit init --prepare-codex-home` can create it; login remains manual.
# This portable default overrides the legacy path in settings.yaml.
FRESHLIT_CODEX_HOME="~/.freshlit-codex"

# Optional: LLM provider. Defaults to "codex" when omitted.
FRESHLIT_LLM_PROVIDER="codex"

# Rollback only: read and required only when FRESHLIT_LLM_PROVIDER="gateway" or
# --provider gateway is explicitly selected. Rotate any previously exposed key
# before rollback use.
# OPENCODE_GO_API_KEY=""

# Optional but recommended: free OpenAlex API key (https://docs.openalex.org)
# The legacy mailto polite pool was deprecated Feb 2026; use api_key instead.
# FreshLit still works without it (anonymous rate limits apply).
OPENALEX_API_KEY=""

# Optional: absolute path to the Obsidian vault where digests are written.
# Overrides obsidian.vault_path in config/settings.yaml (which is a public-safe
# default). Keep your real path here so it never enters the repository.
FRESHLIT_VAULT_PATH=""
